---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { LANGS, LANG_LABEL, LANG_NAME, t, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import { waLink } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const links = [
  { href: '#destinos', label: d.nav.destinos },
  { href: '#vehiculo', label: d.nav.vehiculo },
  { href: '#reservar', label: d.nav.reservar },
  { href: '#faq', label: d.nav.faq },
];
---

<header class="header">
  <div class="container header-inner">
    <a href={getRelativeLocaleUrl(lang, '')} class="brand" aria-label={SITE.fullName}>
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 29 L13 11 L19 20 L24 13 L33 29 Z"></path>
        <path d="M10 17 L13 11 L16 16"></path>
      </svg>
      <span class="brand-text">
        <span class="brand-name">{SITE.name}</span>
        <span class="brand-sub">Traslados · {SITE.city}</span>
      </span>
    </a>

    <nav class="nav" id="menu" aria-label="Principal">
      <ul class="nav-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>

      <ul class="langs" aria-label={d.nav.idioma}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={getRelativeLocaleUrl(l, '')}
                hreflang={l}
                lang={l}
                title={LANG_NAME[l]}
                aria-current={l === lang ? 'true' : undefined}
              >
                {LANG_LABEL[l]}
              </a>
            </li>
          ))
        }
      </ul>

      <a href={waLink(d.cta.mensaje)} class="btn btn-wa" target="_blank" rel="noopener">
        <Icon name="chat" />
        {d.nav.cta}
      </a>
    </nav>

    <button class="menu-toggle" type="button" aria-controls="menu" aria-expanded="false" aria-label={d.nav.menu} data-open-label={d.nav.menu} data-close-label={d.nav.cerrar}>
      <span class="icon-open"><Icon name="menu" size={24} /></span>
      <span class="icon-close"><Icon name="close" size={24} /></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
    text-decoration: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.1;
  }
  .brand-sub {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .nav-links {
    gap: 32px;
  }
  .nav-links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-links a:hover {
    color: var(--accent);
  }
  .langs {
    gap: 4px;
  }
  .langs a {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .langs a[aria-current='true'] {
    background: var(--accent-soft);
    color: var(--ink);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .icon-close {
    display: none;
  }

  /* ——— Mobile / tablet ——— */
  @media (max-width: 960px) {
    :root {
      --header-h: 64px;
    }
    .brand-sub {
      display: none;
    }
    .brand-name {
      font-size: 19px;
    }
    .menu-toggle {
      display: grid;
    }
    .nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding: 20px var(--gutter) 28px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .nav-links {
      flex-direction: column;
      gap: 0;
    }
    .nav-links a {
      display: block;
      padding: 14px 0;
      font-size: 18px;
      border-bottom: 1px solid var(--line);
    }
    /* Estado abierto: lo activa el script de abajo */
    .header.is-open .nav {
      display: flex;
    }
    .header.is-open .icon-open {
      display: none;
    }
    .header.is-open .icon-close {
      display: block;
    }
  }
</style>

<script>
  // Menú mobile: un botón que abre/cierra el panel.
  // aria-expanded le avisa a los lectores de pantalla si el menú está abierto.
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  function setOpen(open: boolean) {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
  }

  toggle?.addEventListener('click', () => {
    setOpen(!header?.classList.contains('is-open'));
  });

  // Al tocar un link del menú, se cierra
  header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Tecla Escape cierra el menú
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
