---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import { waLink } from '../lib/whatsapp';
import Icon from './Icon.astro';
import MenuPreferencias from './MenuPreferencias.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const links = [
  { href: '#destinos', label: d.nav.destinos },
  // "La camioneta" ya no es una sección: abre la ventana emergente (VehiculoModal.astro)
  { href: '#vehiculo-modal', label: d.nav.vehiculo, modal: true },
  { href: '#faq', label: d.nav.faq },
];
---

<header class="header">
  <div class="container header-inner">
    <a href={getRelativeLocaleUrl(lang, '')} class="brand" aria-label={SITE.fullName}>
      <Logo />
      <span class="brand-name">{SITE.fullName}</span>
    </a>

    <nav class="nav" id="menu" aria-label="Principal">
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              {'modal' in l ? (
                <a href={l.href} data-abrir-vehiculo aria-haspopup="dialog" aria-controls="vehiculo-modal">
                  {l.label}
                </a>
              ) : (
                <a href={l.href}>{l.label}</a>
              )}
            </li>
          ))
        }
      </ul>

      <a href={waLink(d.cta.mensaje)} class="btn btn-wa" target="_blank" rel="noopener">
        <Icon name="chat" />
        {d.nav.cta}
      </a>
    </nav>

    <div class="header-actions">
      <MenuPreferencias lang={lang} />
      <button class="menu-toggle" type="button" aria-controls="menu" aria-expanded="false" aria-label={d.nav.menu} data-open-label={d.nav.menu} data-close-label={d.nav.cerrar}>
      <span class="icon-open"><Icon name="menu" size={24} /></span>
      <span class="icon-close"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.1;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-left: auto;
  }
  .header-actions {
    flex: none; /* que el botón de idioma nunca se comprima */
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .nav-links {
    gap: 32px;
  }
  .nav-links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-links a:hover {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    place-items: center;
  }
  .icon-close {
    display: none;
  }

  /* Pantallas medianas (laptops chicas, tablets horizontales): achicamos
     separaciones y escondemos el subtítulo para que el menú entre en 1 renglón */
  @media (max-width: 1180px) {
    .header-inner,
    .nav,
    .nav-links {
      gap: 16px;
    }
  }
  .nav-links a,
  .brand-name {
    white-space: nowrap;
  }

  /* ——— Mobile / tablet ——— */
  @media (max-width: 960px) {
    :root {
      --header-h: 64px;
    }
    .brand-name {
      font-size: 19px;
    }
    .menu-toggle {
      display: grid;
    }
    .nav {
      display: none;
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding: 20px var(--gutter) 28px;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .nav-links {
      flex-direction: column;
      gap: 0;
    }
    .nav-links a {
      display: block;
      padding: 14px 0;
      font-size: 18px;
      border-bottom: 1px solid var(--line);
    }
    /* Estado abierto: lo activa el script de abajo */
    .header.is-open .nav {
      display: flex;
    }
    .header.is-open .icon-open {
      display: none;
    }
    .header.is-open .icon-close {
      display: block;
    }
  }

  /* Celulares muy angostos (iPhone SE 1ª gen, 320 px): todo un poco más junto
     para que la hamburguesa no quede cortada */
  @media (max-width: 380px) {
    .header-inner {
      gap: 8px;
    }
    .brand {
      gap: 8px;
    }
    .brand-name {
      font-size: 15px;
    }
  }
  /* Celus muy angostos (320 px): el nombre largo pasa a dos renglones
     ("Inty Caren / Transfers") en vez de empujar la hamburguesa afuera */
  @media (max-width: 360px) {
    .brand-name {
      white-space: normal;
      line-height: 1.05;
      max-width: 9ch;
    }
  }
</style>

<script>
  // Menú mobile: un botón que abre/cierra el panel.
  // aria-expanded le avisa a los lectores de pantalla si el menú está abierto.
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');

  function setOpen(open: boolean) {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    // Avisamos al resto de la página que se abrió este menú (ver MenuPreferencias)
    if (open) document.dispatchEvent(new CustomEvent('menu:open', { detail: 'nav' }));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
  }

  toggle?.addEventListener('click', () => {
    setOpen(!header?.classList.contains('is-open'));
  });

  // Al tocar un link del menú, se cierra
  header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Si se abre otro menú (el de idioma/tema), cerramos este
  document.addEventListener('menu:open', (e) => {
    if ((e as CustomEvent).detail !== 'nav') setOpen(false);
  });

  // Tecla Escape cierra el menú
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
