---
import { t, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
const year = new Date().getFullYear();

/**
 * Mail: en la compu, un link "mailto:" abre el programa de correo instalado
 * (en Windows suele ser Outlook, que pide iniciar sesión en Microsoft).
 * Por eso en la compu abrimos directo la ventana "Redactar" de Gmail web,
 * con el destinatario y el asunto ya cargados.
 * En el celu dejamos mailto: ahí abre la app de correo del teléfono
 * (Gmail en Android), que es lo más cómodo. El cambio lo hace el script de abajo.
 */
const asunto = encodeURIComponent(d.footer.asunto);
const gmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${SITE.email}&su=${asunto}`;
const mailto = `mailto:${SITE.email}?subject=${asunto}`;
---

<footer class="footer">
  <div class="container inner">
    <span>© {year} {SITE.fullName} · {SITE.city}, {SITE.region}. {d.footer.rights}</span>
    <span class="links">
      <a href={gmail} target="_blank" rel="noopener" data-mailto={mailto} class="mail">{SITE.email}</a>
      <a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramHandle}</a>
    </span>
  </div>
</footer>

<script>
  // Pantallas táctiles (celus/tablets): usar la app de correo del teléfono
  if (window.matchMedia('(pointer: coarse)').matches) {
    document.querySelectorAll<HTMLAnchorElement>('a.mail[data-mailto]').forEach((a) => {
      a.href = a.dataset.mailto!;
      a.removeAttribute('target');
    });
  }
</script>

<style>
  .footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .inner {
    padding-top: 40px;
    /* espacio extra abajo para que el botón flotante no tape el texto */
    padding-bottom: 96px;
    display: flex;
    justify-content: space-between;
    gap: 16px 32px;
    flex-wrap: wrap;
    font-size: 15px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap; /* en pantallas angostas el email y el Instagram bajan de línea */
    gap: 8px 24px;
    min-width: 0;
  }
  .links a {
    overflow-wrap: anywhere; /* un email largo nunca empuja el ancho de la página */
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
  }
</style>
