---
/**
 * Íconos SVG en línea (sin librerías externas).
 * Uso: <Icon name="chat" size={20} />
 * `aria-hidden` porque son decorativos: el texto del botón ya dice qué hace.
 */
interface Props {
  name: 'chat' | 'menu' | 'close' | 'van' | 'arrow' | 'arrowUp' | 'sun' | 'moon' | 'globe' | 'chevronDown' | 'check';
  size?: number;
}
const { name, size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'chat' && <path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {
    name === 'van' && (
      <>
        <path d="M3 16V11l2-5h14l2 5v5" />
        <path d="M3 16h18" />
        <circle cx="7" cy="17" r="2" />
        <circle cx="17" cy="17" r="2" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrowUp' && <path d="M12 19V5M6 11l6-6 6 6" />}
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
      </>
    )
  }
  {name === 'chevronDown' && <path d="M6 9l6 6 6-6" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
</svg>
