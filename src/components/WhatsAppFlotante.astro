---
import { t, type Lang } from '../i18n/ui';
import { waLink } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
---

{/* Desktop: botón redondo. Mobile: barra fija abajo con texto (más fácil de tocar). */}
<a href={waLink(d.cta.mensaje)} class="wa-float" target="_blank" rel="noopener" aria-label={d.float}>
  <Icon name="chat" size={28} />
  <span class="label">{d.float}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 40;
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: var(--wa);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-float);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .wa-float:hover {
    background: var(--wa-hover);
    color: #fff;
    transform: scale(1.05);
  }
  .label {
    display: none;
  }
  @media (max-width: 560px) {
    .wa-float {
      left: 16px;
      right: 16px;
      bottom: 16px;
      width: auto;
      height: 54px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-weight: 600;
      text-decoration: none;
    }
    .wa-float :global(svg) {
      width: 22px;
      height: 22px;
    }
    .label {
      display: inline;
    }
  }
</style>
