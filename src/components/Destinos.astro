---
import { t, type Lang } from '../i18n/ui';
import { DESTINOS, type Categoria, type Destino } from '../data/destinos';
import { waLink } from '../lib/whatsapp';
import Ilustracion from './Ilustracion.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const destacados = DESTINOS.filter((x) => x.destacado);
const resto = DESTINOS.filter((x) => !x.destacado);
const categorias: Categoria[] = ['excursion', 'traslado', 'estancia', 'chile'];

/** "≈ 80 km", o el texto especial, o "Consultá" */
function distancia(x: Destino): string {
  if (x.km !== null) return `${d.approx} ${x.km} km`;
  return x.distanciaTexto?.[lang] ?? d.destinos.consulta;
}
---

<section id="destinos" class="section container">
  <div class="head">
    <div>
      <span class="eyebrow">{d.destinos.eyebrow}</span>
      <h2 class="h2">{d.destinos.title}</h2>
    </div>
    <p>{d.destinos.intro}</p>
  </div>

  <div class="featured">
    {
      destacados.map((x) => (
        <article class="card">
          <div class="card-media">
            <Ilustracion tipo={x.destacado!.ilustracion} alt={x.nombre[lang]} />
            <span class="tag">{d.destinos.cat[x.categoria]}</span>
          </div>
          <div class="card-body">
            <h3>{x.nombre[lang]}</h3>
            <p>{x.destacado!.descripcion[lang]}</p>
            <div class="card-foot">
              <span class="dist">{distancia(x)}</span>
              <a href={waLink(d.destinos.mensaje(x.nombre[lang]))} target="_blank" rel="noopener">
                {d.destinos.consultar} →
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {/* Filtros: botones con aria-pressed (accesibles) + un script chico abajo */}
  <div class="filters" role="group" aria-label={d.destinos.eyebrow}>
    <button type="button" data-filter="all" aria-pressed="true">{d.destinos.todos}</button>
    {
      categorias.map((c) => (
        <button type="button" data-filter={c} aria-pressed="false">
          {d.destinos.catPlural[c]}
        </button>
      ))
    }
  </div>

  <ul class="list">
    {
      resto.map((x) => (
        <li data-cat={x.categoria}>
          <a href={waLink(d.destinos.mensaje(x.nombre[lang]))} target="_blank" rel="noopener">
            <span>
              <strong>{x.nombre[lang]}</strong>
              <small>
                {d.destinos.cat[x.categoria]} · {distancia(x)}
              </small>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
    <li data-cat="otro">
      <a href={waLink(d.destinos.mensajeOtro)} target="_blank" rel="noopener">
        <span>
          <strong>{d.destinos.otroTitulo}</strong>
          <small>{d.destinos.otroTexto}</small>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 40px;
  }
  .head > div {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .head p {
    max-width: 440px;
    color: var(--muted);
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card-media {
    position: relative;
    aspect-ratio: 5 / 3;
  }
  .card-media :global(svg) {
    width: 100%;
    height: 100%;
  }
  .tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }
  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-body h3 {
    font-size: 26px;
    font-weight: 600;
  }
  .card-body p {
    font-size: 16px;
    color: var(--muted);
  }
  .card-foot {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-foot a {
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .dist {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 40px 0 20px;
  }
  .filters button {
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .list li[hidden] {
    display: none;
  }
  .list a {
    min-height: 76px;
    height: 100%;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }
  .list a:hover {
    border-color: var(--accent);
  }
  .list a > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .list strong {
    font-size: 16px;
    font-weight: 600;
  }
  .list small {
    font-size: 14px;
    color: var(--muted);
  }
  .arrow {
    font-size: 20px;
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 960px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .list {
      grid-template-columns: 1fr;
    }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filters button {
      flex: none;
    }
  }
</style>

<script>
  // Filtro por categoría: muestra/oculta tarjetas con el atributo `hidden`.
  const botones = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const items = document.querySelectorAll<HTMLLIElement>('.list li');

  botones.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filter;

      botones.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      items.forEach((li) => {
        const cat = li.dataset.cat;
        // "otro destino" queda siempre visible
        li.hidden = !(filtro === 'all' || cat === filtro || cat === 'otro');
      });
    });
  });
</script>
