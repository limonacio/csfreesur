---
import { t, type Lang } from '../i18n/ui';
import { DESTINOS_VISIBLES, CATEGORIAS_VISIBLES, type Destino } from '../data/destinos';
import { waLink } from '../lib/whatsapp';
import Ilustracion from './Ilustracion.astro';
import Mapa from './Mapa.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const destacados = DESTINOS_VISIBLES.filter((x) => x.destacado);
const resto = DESTINOS_VISIBLES.filter((x) => !x.destacado);
const categorias = CATEGORIAS_VISIBLES;

/** "≈ 80 km", o el texto especial, o "Consultá" */
function distancia(x: Destino): string {
  if (x.km !== null) return `${d.approx} ${x.km} km`;
  return x.distanciaTexto?.[lang] ?? d.destinos.consulta;
}
---

<section id="destinos" class="section container">
  <div class="head">
    <div>
      <span class="eyebrow">{d.destinos.eyebrow}</span>
      <h2 class="h2">{d.destinos.title}</h2>
    </div>
    <p>{d.destinos.intro}</p>
  </div>

  <div class="featured">
    {
      destacados.map((x) => (
        <article class="card">
          <div class="card-media">
            {
              x.destacado!.foto ? (
                <>
                  <Image
                    src={x.destacado!.foto}
                    alt={x.nombre[lang]}
                    widths={[400, 640, 960]}
                    sizes="(max-width: 960px) 92vw, 400px"
                    loading="lazy"
                    class={x.destacado!.fotoNoche ? 'foto-dia' : undefined}
                  />
                  {x.destacado!.fotoNoche && (
                    <Image
                      src={x.destacado!.fotoNoche}
                      alt={x.nombre[lang]}
                      widths={[400, 640, 960]}
                      sizes="(max-width: 960px) 92vw, 400px"
                      loading="lazy"
                      class="foto-noche"
                    />
                  )}
                </>
              ) : (
                <Ilustracion tipo={x.destacado!.ilustracion} alt={x.nombre[lang]} />
              )
            }
            <span class="tag">{d.destinos.cat[x.categoria]}</span>
          </div>
          <div class="card-body">
            <h3>{x.nombre[lang]}</h3>
            <p>{x.destacado!.descripcion[lang]}</p>
            <div class="card-foot">
              {/* Abre el recorrido en el mapa de abajo */}
              <button type="button" class="dist" data-destino={x.id} aria-pressed="false">
                <Icon name="pin" size={18} />
                {d.mapa.verRecorrido} · {distancia(x)}
              </button>
              <a href={waLink(d.destinos.mensaje(x.nombre[lang]))} target="_blank" rel="noopener">
                {d.destinos.consultar} →
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {/* Lista + mapa: al tocar un destino, el mapa muestra el recorrido */}
  <div class="explorer">
  <div class="explorer-lista">
  {/* Filtros: botones con aria-pressed (accesibles) + un script chico abajo */}
  <div class="filters" role="group" aria-label={d.destinos.eyebrow}>
    <button type="button" data-filter="all" aria-pressed="true">{d.destinos.todos}</button>
    {
      categorias.map((c) => (
        <button type="button" data-filter={c} aria-pressed="false">
          {d.destinos.catPlural[c]}
        </button>
      ))
    }
  </div>

  <ul class="list">
    {
      resto.map((x) => (
        <li data-cat={x.categoria}>
          <button type="button" data-destino={x.id} aria-pressed="false">
            <span>
              <strong>{x.nombre[lang]}</strong>
              <small>
                {d.destinos.cat[x.categoria]} · {distancia(x)}
              </small>
            </span>
            <span class="arrow" aria-hidden="true"><Icon name="pin" size={20} /></span>
          </button>
        </li>
      ))
    }
    <li data-cat="otro">
      <a href={waLink(d.destinos.mensajeOtro)} target="_blank" rel="noopener">
        <span>
          <strong>{d.destinos.otroTitulo}</strong>
          <small>{d.destinos.otroTexto}</small>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
  </div>
  <div class="explorer-mapa">
    <Mapa lang={lang} destinos={DESTINOS_VISIBLES} />
  </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 40px;
  }
  .head > div {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .head p {
    max-width: 440px;
    color: var(--muted);
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 5; /* vertical: entran picos, bosque y laguna */
  }
  .card-media :global(svg),
  .card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-media :global(img) {
    object-fit: cover;
  }
  /* Foto de día / de noche: usa el mismo data-logo que pone el script del
     logo en Base.astro (22:00 a 06:00, hora de El Calafate) */
  .card-media :global(.foto-noche) {
    display: none;
  }
  :global([data-logo='night']) .card-media :global(.foto-noche) {
    display: block;
  }
  :global([data-logo='night']) .card-media :global(.foto-dia) {
    display: none;
  }
  .tag {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--surface);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }
  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card-body h3 {
    font-size: 26px;
    font-weight: 600;
  }
  .card-body p {
    font-size: 16px;
    color: var(--muted);
  }
  .card-foot {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-foot a {
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .dist {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .dist:hover,
  .dist[aria-pressed='true'] {
    color: var(--accent);
  }

  /* ——— Lista + mapa ——— */
  .explorer {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    align-items: start;
  }
  /* min-width: 0 evita que los chips (que scrollean de costado en el celu)
     estiren la columna más allá de la pantalla */
  .explorer > * {
    min-width: 0;
  }
  .explorer-mapa {
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 16px;
  }
  .filters button {
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .list li[hidden] {
    display: none;
  }
  .list a,
  .list button {
    width: 100%;
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-height: 76px;
    height: 100%;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }
  .list a:hover,
  .list button:hover {
    border-color: var(--accent);
  }
  /* El destino elegido queda marcado */
  .list button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .list :is(a, button) > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .list strong {
    font-size: 16px;
    font-weight: 600;
  }
  .list small {
    font-size: 14px;
    color: var(--muted);
  }
  .arrow {
    display: grid;
    font-size: 20px;
    color: var(--accent);
  }

  @media (max-width: 1100px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 960px) {
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .featured {
      grid-template-columns: 1fr;
    }
    /* En celu/tablet: primero el mapa, abajo la lista */
    .explorer {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .explorer-mapa {
      position: static;
      order: -1;
    }
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .list {
      grid-template-columns: 1fr;
    }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filters button {
      flex: none;
    }
  }
</style>

<script>
  // Filtro por categoría: muestra/oculta tarjetas con el atributo `hidden`.
  const botones = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const items = document.querySelectorAll<HTMLLIElement>('.list li');
  const mapa = document.querySelector<HTMLElement>('[data-mapa]');

  botones.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filtro = btn.dataset.filter;

      botones.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      // El mapa resalta los pines de esa categoría
      if (mapa && filtro) mapa.dataset.filtro = filtro;

      items.forEach((li) => {
        const cat = li.dataset.cat;
        // "otro destino" queda siempre visible
        li.hidden = !(filtro === 'all' || cat === filtro || cat === 'otro');
      });
    });
  });
</script>
