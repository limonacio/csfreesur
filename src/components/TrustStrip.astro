---
import { t, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang);
// Con Chile activo se muestra "Cruces a Chile"; sin Chile, "Reservás por WhatsApp"
const items = d.trust.filter((x: { soloChile?: boolean; sinChile?: boolean }) =>
  SITE.chile ? !x.sinChile : !x.soloChile
);
---

<div class="container">
  <ul class="trust">
    {
      items.map((item) => (
        <li>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .trust {
    list-style: none;
    margin: 0;
    padding: 28px 40px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  strong {
    font-size: 17px;
  }
  span {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 24px;
      gap: 24px;
    }
  }
  @media (max-width: 520px) {
    .trust {
      grid-template-columns: 1fr;
    }
  }
</style>
